# Copy to .env and fill in what you need.

# "ollama" (local, default) or "google" (Gemini API)
LLM_PROVIDER=ollama

# Optional Ollama model overrides
# OLLAMA_CHAT_MODEL=qwen3.5:4b
# OLLAMA_LARGE_CHAT_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=embeddinggemma

# Required only when LLM_PROVIDER=google
GOOGLE_API_KEY=
# GOOGLE_CHAT_MODEL=gemini-3.8-flash
# GOOGLE_EMBED_MODEL=models/gemini-embedding-001

# Optional: LangSmith tracing for the @traceable functions
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
